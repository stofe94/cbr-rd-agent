# ─── CBR-RD-Agent credentials ─────────────────────────────────────────────────
# Copy to secrets.env: in the repository root for a local run (run_linux.sh),
# or to ~/tmp/secrets.env for the Docker scripts (exe_docker_*).
# secrets.env is listed in .gitignore and must never be committed.
# Write plain KEY=value lines: no quotes and no comments after a value
# (exe_docker_windows.bat reads this file line by line).

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Needs access to the chat model (GOOGLE_AI_STUDIO_CHAT_MODEL, default gemma-4-31b-it)
# and the embedding model (GOOGLE_AI_STUDIO_EMBEDDING_MODEL, default gemini-embedding-001).
GOOGLE_AI_STUDIO_API_KEY=

# Kaggle API credentials (kaggle.com → Settings → API → Create New Token).
# Used to download competition data and, with DS_KAGGLE_LIVE_EVAL=True, to submit.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Leave empty: the Docker scripts then build the image locally from this repository.
# Only the maintainer sets a GitHub token here, to pull the private pre-built image.
GHCR_TOKEN=
