# ─── CBR-RD-Agent configuration ───────────────────────────────────────────────
# Copy to config.env: in the repository root for a local run (run_linux.sh),
# or to ~/tmp/config.env for the Docker scripts (exe_docker_*).
# Credentials go into secrets.env (see secrets.env.example), never into this file.

# ─── Global retry ─────────────────────────────────────────────────────────────
MAX_RETRY=6
RETRY_WAIT_SECONDS=5
PYTHONFAULTHANDLER=0
LOG_LEVEL=INFO


# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND=rdagent.oai.backend.google_ai_studio.GoogleAIStudioAPIBackend

# ─── Model ────────────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_CHAT_MODEL=gemma-4-31b-it
GOOGLE_AI_STUDIO_EMBEDDING_MODEL=gemini-embedding-001

# ─── Sampling ─────────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_CHAT_TEMPERATURE=1
GOOGLE_AI_STUDIO_CHAT_TOP_P=0.95
GOOGLE_AI_STUDIO_CHAT_TOP_K=64
GOOGLE_AI_STUDIO_ENABLE_THINKING=false

# ─── Token limits ─────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_CHAT_MAX_TOKENS=8192

# Static fallback only — dynamic_tokens.py overrides this per-call.
GOOGLE_AI_STUDIO_STRUCTURED_MAX_TOKENS=4096

# Hard ceiling for dynamic estimation.
# Pure JSON calls estimate ~500-1500 and stay well below.
# Code-generation calls estimate ~3000-6000 and approach it.
# Raise to 8192 only if you see finish_reason=length on large code calls.
GOOGLE_AI_STUDIO_STRUCTURED_MAX_TOKENS_CEILING=6144

# Minimum for any call whose schema contains code fields.
# Raise to 4096 if you generate full multi-function pipeline scripts.
GOOGLE_AI_STUDIO_STRUCTURED_CODE_FLOOR_TOKENS=3072

# ─── Timeout ──────────────────────────────────────────────────────────────────
# Wall-clock backstop only — real hang detection done by chunk inactivity.
GOOGLE_AI_STUDIO_REQUEST_TIMEOUT_SECONDS=600

# ─── Stream inactivity hang detection ────────────────────────────────────────
GOOGLE_AI_STUDIO_STREAM_INACTIVITY_TIMEOUT_S=30
GOOGLE_AI_STUDIO_STREAM_CHUNK_WARN_THRESHOLD_S=10

# ─── Streaming ────────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_CHAT_STREAM=true
GOOGLE_AI_STUDIO_DISABLE_STREAM_FOR_STRUCTURED_OUTPUT=true

# ─── Output guard ─────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_ENABLE_OUTPUT_GUARD=true

# ─── Logging ──────────────────────────────────────────────────────────────────
GOOGLE_AI_STUDIO_SHOW_LLM_PROMPTS=true
GOOGLE_AI_STUDIO_SHOW_LLM_RESPONSES=true

# ─── CBR / R&D-Agent ─────────────────────────────────────────────────────────
# DS_RD_LOOP points to the RD loop implementation. To disable the CBR-based
# loop, set it to the default DataScienceRDLoop (no CBR integration).
DS_RD_LOOP=rdagent.scenarios.data_science.cbr.cbr_loop.CBRDataScienceRDLoop
#DS_RD_LOOP=rdagent.scenarios.data_science.loop.DataScienceRDLoop
# CBR configuration
CBR_TOP_K=2
CBR_CASE_SIMILARITY_THRESHOLD=0.5
CBR_MIN_IMPROVEMENT=0.0
CBR_DEDUP_THRESHOLD=0.92
CBR_REQUIRE_IMPROVEMENT=false
# Set to 1 to disable retrieval but keep the rest of the CBR logic (e.g. case storage, similarity calculation, etc.) active. This is useful for ablations.
CBR_DISABLE_RETRIEVAL=0 
CBR_EXCLUDE_COMPETITION=False

# ─── Embedding cache ──────────────────────────────────────────────────────────
USE_EMBEDDING_CACHE=True
DUMP_EMBEDDING_CACHE=True

# ─── Docker ───────────────────────────────────────────────────────────────────
DS_DOCKER_MEM_LIMIT=4g
DS_DOCKER_SHM_SIZE=512m
DS_DOCKER_SHOW_CONTAINER_LOGS_IN_TERMINAL=True
DS_DOCKER_TERMINAL_TAIL_LINES=0
DS_DOCKER_SHOW_DOCKER_RUN_INFO_IN_TERMINAL=False

# ─── Data Science / Kaggle ────────────────────────────────────────────────────
DS_CODER_ON_WHOLE_PIPELINE=True
DS_IF_USING_MLE_DATA=True
DS_KAGGLE_LIVE_EVAL=False
DS_KAGGLE_LIVE_EVAL_STRICT=True
DS_KAGGLE_SUBMISSION_POLL_SECONDS=20
DS_KAGGLE_SUBMISSION_TIMEOUT_SECONDS=900
DS_DEBUG_TIMEOUT=300
DS_FULL_TIMEOUT=900
DS_DEBUG_RECOMMEND_TIMEOUT=240
DS_FULL_RECOMMEND_TIMEOUT=720
DS_SAMPLE_DATA_BY_LLM=True
DS_LOOP_N=8
DS_TIMEOUT=3h

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_DEBUG_TPL=false
RD_AGENT_TRANSIENT_CLEANUP_ON_EXIT=true
RD_AGENT_CLEANUP_DEBUG_RUNS_ON_DOCKER_STOP=true
RD_AGENT_CLEANUP_DEBUG_RUNS_ON_EXIT=true
RD_AGENT_UI_CLEAR_LOGS_ON_CLOSE=true
RD_AGENT_ENABLE_RUN_FOLDER_CLEANUP=true