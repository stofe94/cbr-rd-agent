# logs
log/

*.log
**/*.log

# workspace folder
workspace/

# Python cache (at every level)
**/__pycache__
**/*.pyc

# embeddings / caches
*.pkl
*.cache
**/*.pkl
*.db
cache/
pickle_cache/

